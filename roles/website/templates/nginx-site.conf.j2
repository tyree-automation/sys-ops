# Managed by sys-ops (roles/website) — do not edit.
server {
    listen {{ website_listen_port }};
    listen [::]:{{ website_listen_port }};
    server_name {{ website_server_name }};

    root {{ website_root }};
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location /data/ {
        add_header Cache-Control "no-cache";
    }
}
